; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="fishroom"
config/version="1.0.0"
run/main_scene="res://scenes/room/room.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://assets/ui/app_icon.png"
[autoload]

DisplayProfile="*res://scripts/display_profile.gd"
GameState="*res://scripts/game_state.gd"
McpInteractionServer="*res://autoload/mcp_interaction_server.gd"
[debug]

file_logging/enable_file_logging.android=false


[display]

window/size/viewport_width=405
window/size/viewport_height=720
window/size/window_width_override=540
window/size/window_height_override=960
window/size/viewport_width.windows=1280
window/size/viewport_height.windows=720
window/size/window_width_override.windows=1280
window/size/window_height_override.windows=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[rendering/textures/vram_compression]

import_etc2_astc=true

[display/window/stretch]

aspect="expand"
